# Copier ce fichier en `.env` (ignoré par git) et remplir avec les valeurs du projet.

# Supabase > Project Settings > API (projet en région UE)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Cloud > Identifiants OAuth.
# `WEB` est l'ID client vérifié par Supabase, `IOS` sert à la connexion native sur iPhone.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
